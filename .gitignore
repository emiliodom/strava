# Credenciales y sesion de Strava: nunca deben subirse.
connector/.env
connector/.tokens.json

# Crudo descargado de la API (pesado y regenerable con sync.mjs).
data/raw/

# Datos incrustados para abrir la pagina sin servidor (se regenera con build.mjs --js).
datos.js

node_modules/
.DS_Store
Thumbs.db

ano2026_datos.min.anterior.json
ano2026_datos.min copy.json

# El JSON generado (ano2026_datos.min.json) SI se publica a proposito: es la referencia de ejemplo.
# Se excluyen sus copias de seguridad y el crudo de la API (lleva trazados GPS).
ano2026_datos.min.anterior.json
ano2026_datos.min copy.json
index.original.html

# Logo de Strava (marca registrada): no se redistribuye.
strava.png

# Escaneo corporal: los originales (con cara, 150 MB de DNG) no se suben; sí las fotos difuminadas y body360.js
data/body360/

# Registro de comidas: el token y las fotos reales no se suben.
registro/config.php
registro/datos/*
!registro/datos/.htaccess
!registro/datos/.gitkeep
data/comidas/
