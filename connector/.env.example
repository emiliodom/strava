# Copia este archivo a connector/.env y rellénalo.
# Los datos salen de https://www.strava.com/settings/api (crea "My API Application").
# En "Authorization Callback Domain" tienes que poner exactamente:  localhost

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Puerto del servidor que recoge la respuesta de Strava al autorizar.
PUERTO=8765

# Puerto del servidor estático que sirve la página (connector/serve.mjs).
PUERTO_WEB=8000

# Desde cuándo bajar actividades (epoch en segundos). 1767225600 = 2026-01-01.
SYNC_DESDE_EPOCH=1767225600

# Nombre que aparece en la cabecera del JSON generado.
ATLETA=Emilio

# Sólo para connector/deploy.mjs (publicar en Google Cloud Storage).
GCS_BUCKET=
