# Cloudinary para las fotos del registro de comidas (opcional pero recomendado).
# Copia este archivo como  .env  DENTRO de mistrava-store/ (la carpeta hermana de public_html),
# junto a config.php. NO va dentro de public_html ni se versiona en git.
# Si faltan estas claves, api.php sigue funcionando y guarda las fotos en disco (mistrava-store/datos/).
#
# Los valores están en tu panel de Cloudinary (Dashboard → API Keys). El secreto se queda en el
# servidor: api.php firma cada subida; el navegador nunca lo ve.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
# Carpeta donde se guardan las fotos dentro de Cloudinary (opcional; por defecto mistrava/comidas).
#CLOUDINARY_FOLDER=mistrava/comidas
